	(text "Assume stray capacitance equals 10pF according to \nstm32 datasheet (pg. 119)\n18 pF  from osscilator datasheet (pg. 1)\nCalculation from ST AN2867 (pg. 12)\ncl = (cl1 * cl2)/(cl1 + cl2) + cs\n18pF = (cl1 * cl2)/(cl1 + cl2) + 10pF\ncl1 = cl2 = 16pF\n"
		(exclude_from_sim no)
		(at 94.234 169.926 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a9200f80-4710-4a6d-af3b-13d59611b044")
	)
