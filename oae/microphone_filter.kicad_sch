  (text "-150K/10K * -10K/10K = 15 Gain\nAmplifies a signal from amplitude 0.1V - 3.1V"
    (at 78.74 40.64 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid 135107de-9f18-491f-a527-8664be491eeb)
  )
  (text "This revision takes the input and centers the\nDC offset and amplifies the signal rather than\namplifying the offset. - KLA"
    (at 40.64 33.02 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid a135d89b-4759-4466-8789-132208f368ba)
  )
  (text "DC Blocking with a 1V65 bias" (at 45.72 87.63 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid ac533c69-8904-4377-abd5-1ff839adce28)
  )
  (text "These capacitors need to be placed as close \nas possible to the VDD pin of the ADC."
    (at 229.87 128.27 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid cdfffdd0-a453-4bd1-a6a1-94448da82674)
  )
  (text "Frequency range of distortion products: 1.89kHz, 2.49kHz, 4.5kHz\n\nCutoff Frequencies:\nLower: 1/(2pi*R*C) = 1/(2pi*2K*100nF) = 795Hz\nUpper: 1/(2pi*R*C) = 1/(2pi*2K*10nF) = 7.96kHz"
    (at 121.92 111.76 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid e97ac38f-3be2-4502-86a9-9294935ffb46)
  )
  (text "Reducing DC noise with R703" (at 16.51 48.26 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
    (uuid ec5f85f9-fd5a-4b0c-b1a3-8aa4244f84b9)
  )

